[user]
	email = sondre.lindkjolen@spacenorway.com
	name = Sondre Lindkjolen
[push]
	autoSetupRemote = true
	default = current
[pull]
	rebaset = true
	rebase = true
[merge]
	ff = no
[core]
	editor = vim
[rerere]
	enable = true
	autoUpdate = true
[column]
	ui = auto
[branch]
	sort = -committerdate
[maintenance]
	repo = /home/sondre
	repo = /home/sondre/Documents/GitHub/godot
	repo = /home/sondre/Documents/GitHub/GodotDrone
	repo = /home/sondre/Documents/GitHub/godot-cpp
	repo = /home/sondre/Documents/GitHub/godot-fundamentals
	repo = /home/sondre/Documents/GitHub/codility
	repo = /home/sondre/Documents/GitHub/llvm-project
	repo = /home/sondre/Documents/GitHub/cpython
[init]
	templateDir = /home/sondre/.git-template
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[fetch]
	prune = true
